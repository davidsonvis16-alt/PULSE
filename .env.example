# Pulse configuration.
#
# The two Supabase values are required: every listener signs in with an
# account, and Pulse Radio lives on the server. See docs/LAUNCH.md.
#
# Only values that are safe in public belong in this file — it is compiled into
# the app bundle. Provider secrets (the Ticketmaster key in particular) live in
# the Supabase edge function, never here.

# --- Music source -----------------------------------------------------------
# Which registered MusicProvider adapter to search against.
EXPO_PUBLIC_MUSIC_PROVIDER=itunes
# Storefront used for search and charts (ISO-3166 alpha-2).
EXPO_PUBLIC_MUSIC_COUNTRY=US

# --- Accounts and social ----------------------------------------------------
# Safe to publish: the anon key grants nothing without row-level security,
# which the migration in supabase/migrations sets up.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Events -----------------------------------------------------------------
# URL of the Pulse events edge function. Derived from the Supabase URL when
# left blank. The Ticketmaster key sits behind it, server-side.
EXPO_PUBLIC_EVENTS_PROXY_URL=

# --- Sharing ----------------------------------------------------------------
# Your published web link (docs/LAUNCH.md step 2). Shared links and
# password-reset emails open it. Optional on the web itself.
EXPO_PUBLIC_SHARE_BASE_URL=
